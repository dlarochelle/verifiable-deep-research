# You.com API key. Get it (with free credits) at https://you.com/platform
YDC_API_KEY=
# If Search returns 403 on the default host, uncomment this. Host access
# varies by key.
# YDC_SEARCH_URL=https://ydc-index.io/v1/search

# LLM for claim extraction + groundedness judging. Either provider works.
LLM_PROVIDER=parasail
PARASAIL_API_KEY=
PARASAIL_BASE_URL=https://api.parasail.io/v1
# Pick a plain instruct model from GET /v1/models. Reasoning models wrap
# answers in thinking text and break the JSON parse.
PARASAIL_MODEL=parasail-qwen3-235b-a22b-instruct-2507

# Or: LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
