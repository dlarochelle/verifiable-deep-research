modules = ["python-3.11"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[userenv]
[userenv.shared]
LLM_PROVIDER = "parasail"
PARASAIL_BASE_URL = "https://api.parasail.io/v1"
PARASAIL_MODEL = "parasail-qwen3-235b-a22b-instruct-2507"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "uv run uvicorn app.main:app --host 0.0.0.0 --port 5000"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
run = ["uv", "run", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "5000"]
